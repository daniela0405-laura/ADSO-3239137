APP_NAME="Camping Rental"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=es

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=camping
DB_USERNAME=camping
DB_PASSWORD=

# The API is stateless (JWT): no session, cache or queue tables.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
CORS_ORIGIN=http://localhost:5173
